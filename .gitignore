# Rust
/target/
**/target/
**/*.rs.bk
Cargo.lock.old

# Tauri (generated by tauri-build on every compile)
/src-tauri/gen/schemas/

# Node
/node_modules/
/frontend/node_modules/
/frontend/dist/
npm-debug.log*

# Local agent specs / ADRs (not published)
.gemini-spec/
.cursor-spec/
.kiro/
.local-specs/
.local-doc/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Void-and-cluster generator local venv / run logs
/tools/void_and_cluster/.venv/
/tools/void_and_cluster/parity_*.log

# OS
.DS_Store
Thumbs.db

# cargo-fuzz: local only — never commit mutated corpus / build trees
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/corpus/**
# Spec seed corpus for wrap-padding (gamedev.md §7.4) — commit hand-picked seeds.
!/fuzz/corpus/fuzz_ed_wrap_padding/
!/fuzz/corpus/fuzz_ed_wrap_padding/**
/fuzz/Cargo.lock

# Quick Look / XcodeGen build products
/platform/macos/DitherQuickLook/build/
/platform/macos/DitherQuickLook/dist/
/platform/macos/DitherQuickLook/*.xcodeproj/
/target/quicklook/

# Windows shell thumbnail DLL staged for Tauri resources
/src-tauri/previews/

# Local GPU parity / stress run artifacts
/gpu_parity_failures/
/gpu_stress_logs/
/parity_progress.txt
/parity_nightly.log
/parity_full.log
/parity_random.log
