{
  "name": "dither",
  "version": "0.2.1-alpha.2",
  "description": "Dither Yuki \u2014 tile-based dithering studio for pixel art, palettes, and layered images",
  "author": "L'eco non di Bergamo",
  "license": "LicenseRef-FCL-1.0",
  "homepage": "https://github.com/edrdavid1/dith-yuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/edrdavid1/dith-yuki.git"
  },
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:release": "tauri dev --release",
    "tauri:build": "tauri build",
    "clean": "rm -rf frontend/dist frontend/node_modules/.vite && cargo clean -p dither",
    "clean:rust": "cargo clean",
    "clean:all": "rm -rf node_modules frontend/node_modules frontend/dist && cargo clean",
    "fresh": "npm run clean && tauri dev",
    "reset": "npm run clean:all && npm run setup",
    "lint:no-magic-doc1": "bash scripts/check-no-magic-doc1.sh",
    "release:verify": "bash scripts/verify-release-chain.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
