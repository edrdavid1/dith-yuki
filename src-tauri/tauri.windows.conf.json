{
  "build": {
    "beforeBundleCommand": {
      "cwd": "..",
      "script": "bash scripts/build-installer-acceptance.sh && bash scripts/validate-installer-assets.sh && bash scripts/ci-prepare-windows-previews.sh"
    }
  },
  "bundle": {
    "resources": {
      "icons/proj-icon.ico": "proj-icon.ico",
      "icons/pattern-icon.ico": "pattern-icon.ico",
      "previews/dither_shell.dll": "dither_shell.dll"
    },
    "windows": {
      "nsis": {
        "sidebarImage": "icons/win-setup/sidebarImage.bmp",
        "headerImage": "icons/win-setup/headerImage.bmp",
        "installerIcon": "icons/win-setup/installerIcon.ico",
        "uninstallerIcon": "icons/win-setup/installerIcon.ico",
        "uninstallerHeaderImage": "icons/win-setup/uninstallerHeaderImage.bmp",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
