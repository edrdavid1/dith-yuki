{
  "productName": "Dither Yuki",
  "version": "0.2.0",
  "identifier": "com.dither.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dither Yuki",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 12, "y": 14 },
        "backgroundColor": "#CDCDCD"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "L'eco non di Bergamo",
    "copyright": "Copyright © 2026 L'eco non di Bergamo",
    "homepage": "https://github.com/edrdavid1/dith-yuki",
    "license": "FCL-1.0",
    "category": "GraphicsAndDesign",
    "shortDescription": "Tile-based dithering studio for pixel art, palettes, and layered images.",
    "longDescription": "Dither Yuki is a desktop image editor for artists and designers. It applies ordered and error-diffusion dithering, palette quantization, and layer compositing with a tile-based preview so large documents stay responsive. Projects use the .dyproj archive; shareable patterns use .dyuki.",
    "icon": [
      "icons/icon.png",
      "icons/app-icon.icns",
      "icons/app-icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dyproj"],
        "name": "Dither Project",
        "description": "Dither Yuki project archive",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-dither-project",
        "exportedType": {
          "identifier": "com.dither.app.project",
          "conformsTo": ["public.data", "com.pkware.zip-archive"]
        }
      },
      {
        "ext": ["dyuki"],
        "name": "Dither Pattern",
        "description": "Dither Yuki sharable pattern",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-dither-pattern",
        "exportedType": {
          "identifier": "com.dither.app.pattern",
          "conformsTo": ["public.data", "com.pkware.zip-archive"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzN0YzQjUyQzU3QjVDM0YKUldRL1hIdkZVanQvdzE4TU1xcU1lWjdqV1VZSm5UUmYxeUI4YVBqeXI3aURSTVVsakkyc21FY0YK",
      "endpoints": [
        "https://github.com/edrdavid1/dith-yuki/releases/latest/download/latest.json"
      ]
    }
  }
}
